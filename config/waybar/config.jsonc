{
  "layer": "top", "position": "top", "height": 38, "spacing": 8,
  "margin-top": 8, "margin-left": 12, "margin-right": 12,
  "modules-left": ["custom/brand", "hyprland/workspaces", "hyprland/window"],
  "modules-center": ["clock"],
  "modules-right": ["cpu", "memory", "network", "pulseaudio", "battery", "tray", "custom/power"],
  "custom/brand": {"format": "󰚩  NIGHT OPS", "tooltip": true, "tooltip-format": "PARROT // NIGHT OPS — CachyOS", "on-click": "night-ops-menu"},
  "hyprland/workspaces": {"disable-scroll": true, "all-outputs": true, "format": "{icon}", "format-icons": {"1":"󰆍","2":"󰈹","3":"󰖟","4":"󰓓","5":"󰙯","default":"","urgent":""}, "on-click":"activate"},
  "hyprland/window": {"max-length": 48, "separate-outputs": true},
  "clock": {"format": "󰥔  {:%a %d %b  %H:%M}", "tooltip": true},
  "cpu": {"format":"CPU {usage}%", "interval":2, "on-click":"kitty -e btop"},
  "memory": {"format":"RAM {percentage}%", "interval":3, "on-click":"kitty -e btop"},
  "network": {"format-wifi":"󰖩  {essid}", "format-ethernet":"󰈀 Wired", "format-disconnected":"󰖪 Offline", "tooltip":true, "on-click":"night-ops-menu --network"},
  "pulseaudio": {"format":"{icon} {volume}%", "format-muted":"󰝟 Muted", "format-icons":{"default":["󰕿","󰖀","󰕾"]}, "on-click":"pavucontrol", "on-click-right":"pamixer -t"},
  "battery": {"states":{"warning":30,"critical":15}, "format":"{icon} {capacity}%", "format-icons":["󰂎","󰁺","󰁻","󰁼","󰁽","󰁾","󰁿","󰂀","󰂁","󰂂","󰁹"], "on-click":"night-ops-menu --power"},
  "tray":{"spacing":8},
  "custom/power":{"format":"⏻", "tooltip":true, "tooltip-format":"Session actions", "on-click":"night-ops-menu --power"}
}
